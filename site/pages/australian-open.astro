---
import ArenaExperience from '../components/arena1573/ArenaExperience';
import '../styles/arena-preflight.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>1573 Arena · Court Atlas</title>
    <meta name="description" content="An interactive architectural study of 1573 Arena and its Melbourne Park surroundings." />
  </head>
  <body>
    <ArenaExperience client:only="react" />
  </body>
</html>

<style is:global>
  body {
    background: #101110;
    color: #f5f5f0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  button, input, textarea { font-family: inherit; }
  button { letter-spacing: -0.01em; }
  ::selection { background: rgba(255, 90, 31, 0.35); }
</style>
