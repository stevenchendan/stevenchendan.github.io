---
import ArenaExperience from '../components/arena1573/ArenaExperience';
import '../styles/arena-preflight.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Australian Open · Court Atlas</title>
    <meta name="theme-color" content="#11252d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content="Explore Melbourne Park in 3D, from a sunset aerial above Rod Laver Arena to the view from your Australian Open seating section." />
  </head>
  <body>
    <ArenaExperience client:load />
    <noscript><p>Enable JavaScript to explore the interactive court views.</p></noscript>
  </body>
</html>

<style is:global>
  body {
    background: #11252d;
    color: #f5f5f0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'PingFang SC', 'Microsoft YaHei', sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  button, input, textarea { font-family: inherit; }
  button { letter-spacing: -0.01em; }
  ::selection { background: #deef88; color: #11252d; }
  noscript p { position: fixed; inset: auto 0 0; text-align: center; background: #11252d; padding: 12px; }
</style>
